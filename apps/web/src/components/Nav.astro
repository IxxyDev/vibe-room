---
import { getPayloadClient } from '@/lib/payload'

let settings: { telegramUrl?: string; instagramUrl?: string; vkUrl?: string } = {}
try {
  const payload = await getPayloadClient()
  settings = await payload.findGlobal({ slug: 'site-settings' })
} catch (error) {
  console.error('[Nav] Failed to fetch site settings:', error)
}

interface Props {
  activePage?: 'catalog' | 'about'
}

const { activePage = 'catalog' } = Astro.props
---

<nav class="nav">
  <a href="/" class="nav-logo">
    <span class="vibe">Vibe</span>
    <span class="room">Room</span>
  </a>
  <button class="nav-burger" id="nav-burger" aria-controls="nav-links" aria-expanded="false" aria-label="Меню">
    <span></span><span></span><span></span>
  </button>
  <div class="nav-links" id="nav-links">
    <a href="/" class:list={['nav-link', { active: activePage === 'catalog' }]}>Каталог</a>
    <a href="/about" class:list={['nav-link', { active: activePage === 'about' }]}>О коллекции</a>
    <div class="nav-socials">
      {settings.telegramUrl && <a href={settings.telegramUrl} class="nav-social" target="_blank" rel="noopener">TG</a>}
      {settings.instagramUrl && <a href={settings.instagramUrl} class="nav-social" target="_blank" rel="noopener">INST</a>}
      {settings.vkUrl && <a href={settings.vkUrl} class="nav-social" target="_blank" rel="noopener">VK</a>}
    </div>
  </div>
</nav>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .nav-logo { display: flex; align-items: baseline; gap: 2px; }
  .vibe {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 26px;
    color: var(--pink);
    text-shadow: 0 0 30px rgba(255, 61, 154, 0.4);
  }
  .room {
    font-size: 22px;
    font-weight: 600;
    color: var(--cream);
    letter-spacing: 4px;
    text-transform: uppercase;
  }
  .nav-links { display: flex; gap: 32px; align-items: center; }
  .nav-link {
    font-size: 13px; color: var(--cream-dim);
    letter-spacing: 1px; text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-link:hover, .nav-link.active { color: var(--pink); }
  .nav-socials {
    display: flex; gap: 16px; margin-left: 20px;
    padding-left: 20px; border-left: 1px solid var(--border);
  }
  .nav-social {
    font-size: 11px; color: var(--cream-dim); transition: color 0.2s;
  }
  .nav-social:hover { color: var(--pink); }
  .nav-burger {
    display: none; flex-direction: column; gap: 5px;
    background: none; border: none; cursor: pointer; padding: 4px;
  }
  .nav-burger span {
    width: 24px; height: 2px; background: var(--cream);
    transition: transform 240ms ease, opacity 200ms ease;
    transform-origin: center;
  }
  .nav-burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.2);
  }
  .nav-burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .nav { padding: 16px 20px; }
    .nav-burger { display: flex; }

    .nav-links {
      display: none;
      opacity: 0;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      padding: 20px;
      border-bottom: 1px solid var(--border);
      z-index: 100;

      transition: opacity 250ms, display 250ms allow-discrete;
    }

    .nav-links > * {
      opacity: 1;
      translate: 0 0;
      transition: opacity 300ms, translate 500ms;
      transition-delay: var(--delay, 80ms);
    }
    .nav-links > *:nth-child(2) { --delay: 160ms; }
    .nav-links > *:nth-child(3) { --delay: 240ms; }

    .nav-burger[aria-expanded="true"] ~ .nav-links {
      display: flex;
      opacity: 1;

      @starting-style {
        opacity: 0;
      }

      > * {
        @starting-style {
          opacity: 0;
          translate: 0 -8px;
        }
      }
    }

    .nav-socials {
      margin-left: 0; padding-left: 0; border-left: none;
      padding-top: 12px; border-top: 1px solid var(--border);
    }
  }
</style>

<script>
  const burger = document.getElementById('nav-burger')
  const links = document.getElementById('nav-links')

  function setOpen(open: boolean) {
    burger?.setAttribute('aria-expanded', String(open))
    document.body.style.overflow = open ? 'hidden' : ''
  }

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true'
    setOpen(!open)
  })

  links?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setOpen(false))
  })
</script>
