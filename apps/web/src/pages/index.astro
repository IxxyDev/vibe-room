---
import Base from '@/layouts/Base.astro'
import InstrumentCard from '@/components/InstrumentCard.astro'
import CategoryFilter from '@/components/CategoryFilter.astro'
import { getPayloadClient } from '@/lib/payload'

let instruments: Awaited<ReturnType<Awaited<ReturnType<typeof getPayloadClient>>['find']>>['docs'] = []
let categoryList: { slug: string; name: string }[] = []

try {
  const payload = await getPayloadClient()

  const [instrumentsResult, categoriesResult] = await Promise.all([
    payload.find({ collection: 'instruments', sort: 'order', limit: 500, depth: 1 }),
    payload.find({ collection: 'categories', sort: 'order', limit: 100 }),
  ])

  instruments = instrumentsResult.docs
  categoryList = categoriesResult.docs.map((cat) => ({ slug: cat.slug, name: cat.name }))
} catch (error) {
  console.error('[index] Failed to fetch data from CMS:', error)
}
---

<Base
  title="Vibe Room"
  description="Коллекция музыкального оборудования и инструментов — гитары, усилители, педали эффектов"
  canonicalUrl={new URL(Astro.url.pathname, Astro.site).href}
>
  <CategoryFilter categories={categoryList} />
  <p class="empty-state" id="empty-state" hidden>В этой категории пока ничего нет</p>
  <div class="grid" id="instruments-grid">
    {instruments.map((inst) => {
      const category = typeof inst.category === 'object' ? inst.category : null
      const firstImage = Array.isArray(inst.images) && inst.images.length > 0
        ? (typeof inst.images[0] === 'object' ? inst.images[0] : null)
        : null

      return (
        <InstrumentCard
          title={inst.title}
          slug={inst.slug}
          categoryName={category?.name || ''}
          categorySlug={category?.slug || ''}
          imageUrl={firstImage?.sizes?.card?.url || firstImage?.url}
          imageAlt={firstImage?.alt}
          year={inst.year || undefined}
          country={inst.country || undefined}
          weight={inst.weight || undefined}
          status={inst.status as 'available' | 'archive'}
        />
      )
    })}
  </div>
</Base>

<style>
  .grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 16px; padding: 20px 40px 40px;
  }
  .grid > :global(.card) {
    transition: opacity 220ms ease, transform 220ms ease;
  }
  .grid > :global(.card.is-hidden) {
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    position: absolute;
    visibility: hidden;
  }
  .empty-state {
    text-align: center;
    color: var(--cream-dim);
    font-size: 14px;
    padding: 60px 20px;
    letter-spacing: 0.5px;
    animation: fade-in 250ms ease;
  }
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: none; }
  }
  @media (max-width: 768px) {
    .grid { grid-template-columns: repeat(2, 1fr); padding: 16px 20px 32px; gap: 12px; }
  }
  @media (max-width: 480px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
