---
import Base from '@/layouts/Base.astro'
import { getPayloadClient } from '@/lib/payload'
import { richTextToHtml } from '@/lib/richtext'

const payload = await getPayloadClient()
const about = await payload.findGlobal({ slug: 'about' })

const photo = typeof about.photo === 'object' ? about.photo : null
const contentHtml = richTextToHtml(about.content)
---

<Base
  title="О коллекции"
  description="Vibe Room — коллекция музыкального оборудования и инструментов. Гитары, усилители, педали эффектов."
  activePage="about"
>
  <div class="about-page">
    <div class="about-layout">
      <div class="about-photo">
        {photo
          ? <img src={photo.sizes?.full?.url || photo.url} alt={photo.alt || 'Vibe Room'} />
          : <span class="photo-placeholder">Фото</span>
        }
      </div>

      <div class="about-content">
        <div class="about-eyebrow">Guitars · Music · Workshop</div>
        <h1 class="about-title">{about.heading || 'О коллекции'}</h1>

        {contentHtml && (
          <div class="about-text" set:html={contentHtml} />
        )}

        {about.stats && about.stats.length > 0 && (
          <div class="about-stats">
            {about.stats.map((stat: { number: string; label: string }) => (
              <div class="stat">
                <div class="stat-number">{stat.number}</div>
                <div class="stat-label">{stat.label}</div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</Base>

<style>
  .about-page { padding: 60px 40px 80px; }
  .about-layout {
    display: grid; grid-template-columns: 1fr 1.2fr;
    gap: 60px; align-items: start;
  }
  .about-photo {
    aspect-ratio: 3/4; background: linear-gradient(135deg, #15151d, #1a1a24);
    border-radius: 10px; border: 1px solid var(--border); overflow: hidden;
  }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; }
  .photo-placeholder {
    display: flex; align-items: center; justify-content: center;
    width: 100%; height: 100%; color: var(--cream-dim);
    font-size: 13px; letter-spacing: 2px; text-transform: uppercase;
  }
  .about-eyebrow {
    font-size: 11px; text-transform: uppercase; letter-spacing: 3px;
    color: var(--teal); margin-bottom: 16px;
  }
  .about-title {
    font-family: var(--font-accent); font-style: italic;
    font-size: 42px; color: var(--cream); margin-bottom: 32px; line-height: 1.2;
  }
  .about-text {
    font-size: 15px; line-height: 1.8; color: var(--cream-dim); font-weight: 300;
  }
  .about-text :global(p) { margin-bottom: 16px; }
  .about-text :global(strong) { color: var(--cream); font-weight: 500; }
  .about-stats {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 24px; margin-top: 40px;
  }
  .stat {
    text-align: center; padding: 20px 16px;
    background: var(--bg-card); border-radius: 10px; border: 1px solid var(--border);
  }
  .stat-number {
    font-size: 32px; font-weight: 600; color: var(--pink);
    margin-bottom: 4px; text-shadow: 0 0 20px rgba(255, 61, 154, 0.25);
  }
  .stat-label {
    font-size: 11px; color: var(--cream-dim);
    text-transform: uppercase; letter-spacing: 1.5px;
  }

  @media (max-width: 768px) {
    .about-page { padding: 40px 20px 60px; }
    .about-layout { grid-template-columns: 1fr; gap: 32px; }
    .about-photo { aspect-ratio: 16/9; }
    .about-stats { grid-template-columns: 1fr; }
  }
</style>
