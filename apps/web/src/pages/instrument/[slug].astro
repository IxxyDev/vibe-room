---
import Base from '@/layouts/Base.astro'
import ImageGallery from '@/components/ImageGallery.astro'
import { getPayloadClient } from '@/lib/payload'
import { richTextToHtml, richTextToPlainText } from '@/lib/richtext'

export async function getStaticPaths() {
  try {
    const payload = await getPayloadClient()
    const { docs } = await payload.find({
      collection: 'instruments',
      limit: 500,
      depth: 1,
    })

    return docs.map((inst) => ({
      params: { slug: inst.slug },
      props: { instrument: inst },
    }))
  } catch (error) {
    console.error('[instrument] Failed to fetch instruments for static paths:', error)
    return []
  }
}

const { instrument } = Astro.props

let settings: { siteUrl?: string } = {}
try {
  const payload = await getPayloadClient()
  settings = await payload.findGlobal({ slug: 'site-settings' })
} catch (error) {
  console.error('[instrument] Failed to fetch site settings:', error)
}

type GalleryImage = {
  url: string
  alt: string
  sizes?: {
    full?: { url: string }
    card?: { url: string }
    thumbnail?: { url: string }
  }
}

const category = typeof instrument.category === 'object' ? instrument.category : null
const images = (Array.isArray(instrument.images) ? instrument.images : [])
  .filter((img): img is GalleryImage => typeof img === 'object' && typeof img.url === 'string')

const richTextPlain = richTextToPlainText(instrument.description)
const descriptionText = richTextPlain
  || [instrument.year, instrument.country, instrument.brand, instrument.title, category?.name]
      .filter(Boolean)
      .join(', ')

const firstImage = images[0]
const siteUrl = settings.siteUrl || ''
const ogImage = firstImage
  ? `${siteUrl}${firstImage.sizes?.card?.url || firstImage.url}`
  : undefined

const descriptionHtml = richTextToHtml(instrument.description)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'IndividualProduct',
  name: instrument.title,
  description: descriptionText,
  image: images.map((img) => `${siteUrl}${img.sizes?.full?.url || img.url}`),
  brand: instrument.brand ? { '@type': 'Brand', name: instrument.brand } : undefined,
  countryOfOrigin: instrument.country,
  productionDate: instrument.year ? String(instrument.year) : undefined,
}
---

<Base
  title={instrument.title}
  description={descriptionText}
  ogImage={ogImage}
  canonicalUrl={new URL(Astro.url.pathname, Astro.site).href}
  jsonLd={jsonLd}
>
  <div class="instrument-page">
    <nav class="breadcrumbs">
      <a href="/">Каталог</a>
      <span class="sep">/</span>
      {category && (
        <>
          <span>{category.name}</span>
          <span class="sep">/</span>
        </>
      )}
      <span class="current">{instrument.title}</span>
    </nav>

    <div class="instrument-layout">
      <div class="instrument-gallery">
        <ImageGallery images={images} />
      </div>

      <div class="instrument-info">
        {category && <span class="instrument-category">{category.name}</span>}
        <h1 class="instrument-title">{instrument.title}</h1>

        <div class="instrument-meta">
          {instrument.year && <span>{instrument.year}</span>}
          {instrument.country && <span>{instrument.country}</span>}
          {instrument.weight && <span>{instrument.weight} kg</span>}
        </div>

        {descriptionHtml && (
          <div class="instrument-description" set:html={descriptionHtml} />
        )}

        {instrument.specs && instrument.specs.length > 0 && (
          <div class="instrument-specs">
            <h2 class="specs-title">Спецификации</h2>
            <table class="specs-table">
              {instrument.specs.map((spec: { key: string; value: string }) => (
                <tr>
                  <td class="spec-key">{spec.key}</td>
                  <td class="spec-value">{spec.value}</td>
                </tr>
              ))}
            </table>
          </div>
        )}
      </div>
    </div>
  </div>
</Base>

<style>
  .instrument-page { padding: 0 40px 60px; }
  .breadcrumbs { padding: 16px 0; font-size: 12px; color: var(--cream-dim); }
  .breadcrumbs a { color: var(--cream-dim); transition: color 0.2s; }
  .breadcrumbs a:hover { color: var(--pink); }
  .sep { margin: 0 8px; opacity: 0.3; }
  .current { color: var(--cream); }

  .instrument-layout {
    display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; margin-top: 8px;
  }
  .instrument-category {
    font-size: 11px; text-transform: uppercase; letter-spacing: 2px;
    color: var(--teal); margin-bottom: 8px; display: block;
  }
  .instrument-title { font-size: 28px; font-weight: 500; line-height: 1.3; margin-bottom: 16px; }
  .instrument-meta {
    display: flex; gap: 16px; font-size: 13px; color: var(--cream-dim);
    margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid var(--border);
  }
  .instrument-description {
    font-size: 15px; line-height: 1.8; color: var(--cream-dim);
    font-weight: 300; margin-bottom: 32px;
  }
  .instrument-description :global(p) { margin-bottom: 12px; }
  .instrument-description :global(strong) { color: var(--cream); font-weight: 500; }

  .specs-title {
    font-size: 14px; font-weight: 500; text-transform: uppercase;
    letter-spacing: 1px; color: var(--cream); margin-bottom: 16px;
  }
  .specs-table { width: 100%; border-collapse: collapse; }
  .specs-table tr { border-bottom: 1px solid var(--border); }
  .spec-key {
    font-size: 13px; color: var(--cream-dim); padding: 10px 16px 10px 0;
    white-space: nowrap; width: 40%;
  }
  .spec-value { font-size: 13px; color: var(--cream); padding: 10px 0; }

  @media (max-width: 768px) {
    .instrument-page { padding: 0 20px 40px; }
    .instrument-layout { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
